# Used only by plain `vite dev` / `vite build` (build-time). Leave unset to use
# the dev proxy in vite.config.js (backend on localhost:8000).
#
# Docker/production deployments do NOT use this file — the API endpoint there
# is set at container start via the API_BASE_URL env var on the frontend
# container (see docker-compose.yml + frontend/docker-entrypoint.sh), so it can
# change per deployment without a rebuild.
VITE_API_BASE_URL=
