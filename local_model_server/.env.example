# ==============================================================================
# local_model_server configuration.
# Copy to local_model_server/.env and adjust. Never commit the real file.
# ==============================================================================

# Which model to load at startup. internvl-1b | earthmind-4b
# Restart the server with a different value to switch models — there is no
# runtime hot-swap.
LOCAL_VLM_MODEL_ID=internvl-1b

# Override the Hugging Face repo id directly. Takes precedence over the
# LOCAL_VLM_MODEL_ID -> repo mapping baked into server.py, so you can point at a
# different checkpoint (or a newer InternVL release) without touching code.
LOCAL_VLM_HF_REPO=

# auto | cpu | cuda | mps
LOCAL_VLM_DEVICE=auto

# Where downloaded weights are cached. MUST be a persistent volume/mount when
# running in Docker — EarthMind-4B alone is ~15GB and must never be baked into
# an image layer.
LOCAL_VLM_HF_CACHE_DIR=./.hf-cache
HF_HOME=./.hf-cache

LOCAL_VLM_PORT=8080

# Only needed if the chosen repo is gated on Hugging Face.
HF_TOKEN=
