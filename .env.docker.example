# ==============================================================================
# SatQuery configuration for `docker compose` (backend service env_file).
# Copy to `.env.docker`. Identical to .env.example except for the values noted
# below, which use Compose's internal service-name DNS instead of localhost.
# NEVER commit your real `.env.docker` file.
# ==============================================================================

# 1. Sentinel Hub / CDSE credentials — same as .env.example.
SENTINEL_CLIENT_ID=your_sentinel_hub_client_id_here
SENTINEL_CLIENT_SECRET=your_sentinel_hub_client_secret_here

# 2. Orchestrator role — same as .env.example.
SATQUERY_ORCHESTRATOR_PROVIDER=openai
SATQUERY_ORCHESTRATOR_MODEL=gpt-4o
SATQUERY_ORCHESTRATOR_API_KEY=
SATQUERY_ORCHESTRATOR_BASE_URL=
SATQUERY_ORCHESTRATOR_SYNTHESIZE_ANSWER=true

OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 3. Vision tool role.
SATQUERY_VISION_TOOL_ENABLED=true
SATQUERY_VISION_TOOL_PROVIDER=openai
SATQUERY_VISION_TOOL_MODEL=gpt-4o
SATQUERY_VISION_TOOL_API_KEY=
# Different from .env.example: this is the backend container talking to the
# local-vlm container over the Compose network, not to localhost.
# Only relevant when SATQUERY_VISION_TOOL_PROVIDER=local.
SATQUERY_VISION_TOOL_BASE_URL=http://local-vlm:8080
SATQUERY_VISION_TOOL_TIMEOUT_S=60

# 4. Networking / deployment.
SATQUERY_BACKEND_PORT=8000
SATQUERY_CORS_ALLOWED_ORIGINS=*
# Different from .env.example: a fixed in-container path, matching the
# `raster-data` volume mount in docker-compose.yml so fetched imagery persists
# across container restarts instead of vanishing with the container.
SATQUERY_TOOL_OUTPUT_DIR=/app/data/rasters
PROJ_NETWORK=OFF

# 5. Optional memory & state persistence.
SATQUERY_MEMORY_BACKEND=none
# SATQUERY_MEMORY_DB_URL=postgresql://user:password@postgres:5432/satquery_memories
# SATQUERY_MEMORY_EMBED_MODEL=openai:text-embedding-3-small

# ------------------------------------------------------------------------------
# 6. Tool 9: Web Search Intelligence (Tavily + DuckDuckGo Fail-safe)
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
SATQUERY_WEB_SEARCH_PROVIDER=tavily

# ------------------------------------------------------------------------------
# 7. Tool 10: Spatial Geocoding & POI Engine (LocationIQ + OpenStreetMap Fallback)
# ------------------------------------------------------------------------------
LOCATIONIQ_API_KEY=your_locationiq_api_key_here

# ------------------------------------------------------------------------------
# 8. Frontend container configuration
# ------------------------------------------------------------------------------
# Frontend container only — this is the URL the *browser* uses, so it must
# be reachable from the host, not the Compose-internal "backend" hostname.
# Override for a real multi-host deployment (e.g. https://api.example.com).
FRONTEND_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000
