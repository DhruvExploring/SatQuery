# Sentinel Hub credentials (for real satellite imagery tool)
SENTINEL_CLIENT_ID=your_sentinel_hub_client_id
SENTINEL_CLIENT_SECRET=your_sentinel_hub_client_secret
SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret

# LLM planner — Groq (fast inference, OpenAI-compatible)
SATQUERY_MOCK_PLANNER=false
SATQUERY_LLM_PROVIDER=openai
SATQUERY_LLM_MODEL=llama-3.3-70b-versatile
SATQUERY_LLM_BASE_URL=https://api.groq.com/openai/v1
SATQUERY_LLM_API_KEY=your_groq_api_key

# Tool execution — keep mock for now, flip to false for real Sentinel Hub calls
SATQUERY_MOCK_TOOLS=true

# Memory — not needed yet
SATQUERY_MEMORY_BACKEND=none

OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=minimax/minimax-m3:free
