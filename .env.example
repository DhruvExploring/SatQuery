# SatQuery Earth Observation Intelligence System — Environment Variables
# Copy this file to .env and insert your Sentinel Hub / Copernicus Data Space credentials.

# Sentinel Hub / Copernicus Data Space Ecosystem (CDSE) OAuth2 Credentials
# Required for: Tool 1 (Optical), Tool 2 (Multispectral), Tool 3 (SAR)
SENTINEL_CLIENT_ID=your_sentinel_hub_client_id_here
SENTINEL_CLIENT_SECRET=your_sentinel_hub_client_secret_here

# Tool 4 (Weather / ERA5) requires ZERO API keys (Open public science access via Open-Meteo).
# Tools 5, 6, 7, and 8 operate 100% locally and require ZERO external credentials or network calls.
