# ==============================================================================
# SatQuery Configuration (.env.example)
# Copy this file to `.env` and fill in your real values.
# NEVER commit your `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Sentinel Hub Credentials (Tools 1–3: Optical, Multispectral, SAR)
# Register at https://www.sentinel-hub.com/ to obtain OAuth2 client credentials.
# ------------------------------------------------------------------------------
SENTINEL_CLIENT_ID=your_sentinel_hub_client_id_here
SENTINEL_CLIENT_SECRET=your_sentinel_hub_client_secret_here

# ------------------------------------------------------------------------------
# 2. Orchestration Planner Mode
# SATQUERY_MOCK_PLANNER:
#   true  = Deterministic keyword planner (fast, runs offline, no LLM required)
#   false = Live LLM planner (requires either OpenAI or Claude enabled below)
# ------------------------------------------------------------------------------
SATQUERY_MOCK_PLANNER=true

# ------------------------------------------------------------------------------
# 3. Tool Execution Mode
# SATQUERY_MOCK_TOOLS:
#   false = Execute real remote-sensing API calls & generate genuine GeoTIFF rasters
#   true  = Use mock/synthetic rasters (used for offline tests and CI/CD)
# ------------------------------------------------------------------------------
SATQUERY_MOCK_TOOLS=false

# ------------------------------------------------------------------------------
# 4. LLM Provider Configuration (Active when SATQUERY_MOCK_PLANNER=false)
# Exactly ONE provider (OpenAI or Claude) must be enabled if live LLM is used.
# ------------------------------------------------------------------------------
SATQUERY_USE_OPENAI=false
SATQUERY_USE_CLAUDE=false

# OpenAI Configuration
SATQUERY_OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude Configuration
SATQUERY_CLAUDE_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 5. Optional Memory & State Persistence (LangMem)
# ------------------------------------------------------------------------------
SATQUERY_MEMORY_BACKEND=none
# SATQUERY_MEMORY_DB_URL=postgresql://user:password@localhost:5432/satquery_memories
# SATQUERY_MEMORY_EMBED_MODEL=openai:text-embedding-3-small
