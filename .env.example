# SatQuery — copy to .env and fill in real values. Never commit .env.

# Sentinel Hub (Tools 1–3)
SENTINEL_CLIENT_ID=your_sentinel_hub_client_id_here
SENTINEL_CLIENT_SECRET=your_sentinel_hub_client_secret_here

# Orchestration — tools always run for real (no SATQUERY_MOCK_TOOLS).
# true  = keyword planner (offline)
# false = LLM planner (Groq example below)
SATQUERY_MOCK_PLANNER=true

# Live LLM planner (Groq):
# SATQUERY_MOCK_PLANNER=false
# SATQUERY_LLM_PROVIDER=openai
# SATQUERY_LLM_MODEL=llama-3.3-70b-versatile
# SATQUERY_LLM_BASE_URL=https://api.groq.com/openai/v1
# SATQUERY_LLM_API_KEY=gsk_your_groq_key_here
