# ==============================================================================
# SatQuery configuration (.env.example)
# Copy this file to `.env` (bare-metal/native runs) and fill in real values.
# For Docker Compose, copy `.env.docker.example` to `.env.docker` instead —
# the two differ only in a handful of internal-hostname values, marked below.
# NEVER commit your real `.env` / `.env.docker` files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Sentinel Hub / CDSE credentials (Tools 1-3: optical, multispectral, SAR)
# Register at https://www.sentinel-hub.com/ or https://dataspace.copernicus.eu/
# ------------------------------------------------------------------------------
SENTINEL_CLIENT_ID=your_sentinel_hub_client_id_here
SENTINEL_CLIENT_SECRET=your_sentinel_hub_client_secret_here

# ------------------------------------------------------------------------------
# 2. Orchestrator role — picks which tool to call next, and (when enabled)
# writes the final narrative answer. See backend/orchestrator/llm.py and
# backend/orchestrator/synthesis.py.
# ------------------------------------------------------------------------------
# mock      = deterministic keyword planner, no API key needed, no narrative synthesis
# openai    = ChatOpenAI (e.g. GPT-4o)
# anthropic = ChatAnthropic (e.g. Claude)
SATQUERY_ORCHESTRATOR_PROVIDER=openai
SATQUERY_ORCHESTRATOR_MODEL=gpt-4o
SATQUERY_ORCHESTRATOR_API_KEY=
# Optional proxy/Azure-style override. Falls back to OPENAI_API_KEY /
# ANTHROPIC_API_KEY below when SATQUERY_ORCHESTRATOR_API_KEY is unset.
SATQUERY_ORCHESTRATOR_BASE_URL=
# Only used when the orchestrator provider above is not "mock".
SATQUERY_ORCHESTRATOR_SYNTHESIZE_ANSWER=true

OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 3. Vision tool role — interprets a rendered image on request, called like any
# other tool (see backend/vision/, backend/tools/executor.py). API is the
# primary path; "local" (InternVL-1B or EarthMind-4B via local_model_server/)
# is a deployment-time config choice, not an automatic runtime fallback.
# ------------------------------------------------------------------------------
SATQUERY_VISION_TOOL_ENABLED=true
# openai = hosted OpenAI-compatible vision model
# local  = local_model_server/ sidecar (see that folder's README for setup)
SATQUERY_VISION_TOOL_PROVIDER=openai
SATQUERY_VISION_TOOL_MODEL=gpt-4o
SATQUERY_VISION_TOOL_API_KEY=
# For provider=openai: an OpenAI-compatible base URL override (optional).
# For provider=local: the local_model_server URL.
#   Native run on this machine: http://localhost:8080
#   Docker Compose:             http://local-vlm:8080   <- .env.docker value
SATQUERY_VISION_TOOL_BASE_URL=
SATQUERY_VISION_TOOL_TIMEOUT_S=60

# ------------------------------------------------------------------------------
# 4. Networking / deployment — nothing here should be hardcoded elsewhere.
# ------------------------------------------------------------------------------
SATQUERY_BACKEND_PORT=8000
# Comma-separated list, or "*" for local dev. Restrict this in production.
SATQUERY_CORS_ALLOWED_ORIGINS=*
# Where Tools 1-3 write fetched GeoTIFFs. Relative paths resolve against the
# SatQuery project root (or /app inside the backend container).
SATQUERY_TOOL_OUTPUT_DIR=sih_satellite_data
# Avoids a multi-minute hang on the first CRS operation when this machine has
# no network route to the PROJ CDN grid registry (rasterio/GDAL dependency).
# Safe to leave OFF unless you specifically need PROJ's network-fetched grids.
PROJ_NETWORK=OFF

# ------------------------------------------------------------------------------
# 5. Optional memory & state persistence (LangMem)
# ------------------------------------------------------------------------------
SATQUERY_MEMORY_BACKEND=none
# SATQUERY_MEMORY_DB_URL=postgresql://user:password@localhost:5432/satquery_memories
# SATQUERY_MEMORY_EMBED_MODEL=openai:text-embedding-3-small

# ------------------------------------------------------------------------------
# 6. Tool 9: Web Search Intelligence (Tavily + DuckDuckGo Fail-safe)
# Optional — falls back to DuckDuckGo when unset.
# Get a key at https://tavily.com/ (1000 free searches/month). Leave blank to
# use DuckDuckGo directly.
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
# Force a provider instead of auto-selecting by key presence: tavily | duckduckgo
SATQUERY_WEB_SEARCH_PROVIDER=tavily

# ------------------------------------------------------------------------------
# 7. Tool 10: Spatial Geocoding & POI Engine (LocationIQ + OpenStreetMap Fallback)
# Optional — falls back to OpenStreetMap Nominatim when unset.
# Get a key at https://locationiq.com/ (5000 free requests/day). Leave blank
# to use OpenStreetMap Nominatim directly (rate-limited, no key needed).
# ------------------------------------------------------------------------------
LOCATIONIQ_API_KEY=your_locationiq_api_key_here

# ------------------------------------------------------------------------------
# 8. Frontend configuration
# ------------------------------------------------------------------------------
# Frontend container / browser URL
FRONTEND_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000
